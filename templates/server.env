{# Values for scripts/run.sh, which sources this file. Every value goes
   through shell_quote, so no value can turn into a command. -#}
# Generated by easy-openvpn-server for run.sh. Don't edit: `setup` overwrites it.
TUNNEL_NETWORK={{ tunnel_network_cidr | shell_quote }}
TUNNEL_NETWORK_6={{ tunnel_network_v6 | shell_quote }}
DNS_SERVERS=({{ (dns_servers + dns_servers_v6) | map('shell_quote') | join(' ') }})
CLIENT_TO_CLIENT={{ client_to_client | shell_quote }}
